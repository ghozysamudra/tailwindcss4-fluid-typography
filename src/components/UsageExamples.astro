---
import Section from "./ui/Section.astro";
import Container from "./ui/Container.astro";
import Card from "./ui/Card.astro";

const examples = [
  {
    id: "blog",
    label: "Blog",
    previewTitle: "Designing with fluid rhythm",
    previewBody: "A readable article flow with stable hierarchy from mobile to desktop.",
    code: `<article class="max-w-3xl mx-auto">
  <p class="text-h6 text-sky-600">Editorial</p>
  <h1 class="text-h2">Designing with fluid rhythm</h1>
  <p class="text-body-lg text-slate-600">A readable article intro that scales gently.</p>
  <p class="text-body">Paragraph copy with consistent line-height.</p>
</article>`
  },
  {
    id: "hero",
    label: "Landing Hero",
    previewTitle: "Craft better first impressions",
    previewBody: "Display text remains dramatic without overwhelming small screens.",
    code: `<section class="text-center">
  <p class="text-overline text-sky-700">Now Shipping</p>
  <h1 class="text-display-xl">Craft better first impressions</h1>
  <p class="text-body-xl text-slate-600">Fluid typography keeps this hero balanced everywhere.</p>
</section>`
  },
  {
    id: "card",
    label: "Card",
    previewTitle: "Plan once, scale everywhere",
    previewBody: "Reusable card modules can share typography semantics with the whole site.",
    code: `<article class="p-6 rounded-2xl border">
  <h3 class="text-h3">Plan once, scale everywhere</h3>
  <p class="text-body text-slate-600">Card text stays proportional at every breakpoint.</p>
</article>`
  },
  {
    id: "dashboard",
    label: "Dashboard",
    previewTitle: "$124,500",
    previewBody: "Stats views can use display classes while preserving UI clarity.",
    code: `<div class="p-6 rounded-xl border">
  <p class="text-caption text-slate-500">Total Revenue</p>
  <p class="text-display-lg font-bold">$124,500</p>
  <p class="text-body-sm text-green-700">+12% from last month</p>
</div>`
  }
];
---

<Section id="usage">
  <Container class="opacity-0 translate-y-5 transition duration-500 [will-change:transform,opacity]" data-reveal>
    <h2 class="m-0 text-h2">Usage Examples</h2>
    <p class="mt-2 text-body text-[color:var(--text-muted)]">
      Switch examples to inspect practical implementation patterns with copy-ready snippets.
    </p>

    <Card class="mt-5 overflow-hidden p-5">
      <div class="mb-4 flex flex-wrap gap-2" role="tablist" aria-label="Usage tabs">
        {examples.map((example, idx) => (
          <button
            type="button"
            class="whitespace-nowrap rounded-full border border-[color:var(--line)] bg-[color:var(--surface)] px-4 py-2 text-body-sm text-[color:var(--text)] transition hover:bg-[color:var(--bg-muted)] aria-selected:border-[color:var(--accent)] aria-selected:bg-[color:var(--accent)] aria-selected:text-white"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            data-example-tab={example.id}
          >
            {example.label}
          </button>
        ))}
      </div>

      {examples.map((example, idx) => (
        <article class:list={["grid gap-4 md:grid-cols-2", idx === 0 ? "" : "hidden"]} data-example-panel={example.id} role="tabpanel">
          <Card class="min-w-0 overflow-hidden p-5">
            <p class="font-['IBM_Plex_Mono'] text-h6 text-[color:var(--text-muted)]">Preview</p>
            <h3 class="mt-2 break-words text-h2">{example.previewTitle}</h3>
            <p class="break-words text-body text-[color:var(--text-muted)]">{example.previewBody}</p>
          </Card>
          <Card class="min-w-0 overflow-hidden p-5">
            <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
              <p class="m-0 font-['IBM_Plex_Mono'] text-h6 text-[color:var(--text-muted)]">Code</p>
              <button type="button" class="rounded-md border border-[color:var(--line)] bg-[color:var(--bg)] px-2 py-1 font-['IBM_Plex_Mono'] text-caption text-[color:var(--text)] transition [&[data-copied='true']]:border-[color:var(--ok)] [&[data-copied='true']]:text-[color:var(--ok)]" data-copy={example.code}>Copy</button>
            </div>
            <pre class="m-0 w-full max-w-full overflow-x-auto rounded-lg bg-[color:var(--bg-muted)] p-3 font-['IBM_Plex_Mono'] text-body-sm">{example.code}</pre>
          </Card>
        </article>
      ))}
    </Card>
  </Container>

  <script>
    const tabs = Array.from(document.querySelectorAll("[data-example-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-example-panel]"));

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (!(tab instanceof HTMLButtonElement)) return;
        const id = tab.dataset.exampleTab;
        if (!id) return;

        tabs.forEach((item) => {
          if (!(item instanceof HTMLButtonElement)) return;
          item.setAttribute("aria-selected", String(item.dataset.exampleTab === id));
        });

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.classList.toggle("hidden", panel.dataset.examplePanel !== id);
        });
      });
    });
  </script>
</Section>
