---
import Section from "./ui/Section.astro";
import Container from "./ui/Container.astro";
import Button from "./ui/Button.astro";
---

<Section id="cta">
  <Container class="opacity-0 translate-y-5 transition duration-500 [will-change:transform,opacity]" data-reveal>
    <div class="rounded-2xl border border-[color:var(--line)] bg-[color:var(--accent-soft)] p-7 text-center md:p-10">
      <p class="m-0 text-overline text-[color:var(--accent)]">Ready to Ship</p>
      <h2 class="mb-3 mt-2 text-display">Make fluid typography your default.</h2>
      <p class="mx-auto max-w-2xl text-body-lg text-[color:var(--text-muted)]">
        Drop in the CSS file, tune six variables, and deliver a type system that feels consistent
        across every device size.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href="https://github.com/ghozysamudra/tailwindcss4-fluid-typography" target="_blank" rel="noreferrer" variant="primary" class="text-body">View on GitHub</Button>
        <Button href="#getting-started" class="text-body">Install in 3 minutes</Button>
      </div>
    </div>
  </Container>
</Section>
