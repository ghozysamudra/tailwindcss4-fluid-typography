---
import Section from "./ui/Section.astro";
import Container from "./ui/Container.astro";
---

<Section class="pt-8">
  <Container>
    <div class="grid gap-4 border-t border-[color:var(--line)] pt-6 md:grid-cols-2">
      <div>
        <p class="mb-2 mt-0 text-h4">Tailwind Fluid Typography</p>
        <p class="m-0 text-body-sm text-[color:var(--text-muted)]">
          Built for Tailwind CSS v4 with semantic classes and precise clamp-based scaling.
        </p>
        <p class="mt-2 text-body-sm text-[color:var(--text-muted)]">
          Open source on
          <a href="https://github.com/ghozysamudra/tailwindcss4-fluid-typography" target="_blank" rel="noreferrer" class="underline">GitHub</a>
          · Made by
          <a href="https://ghozysamudra.com/" target="_blank" rel="noreferrer" class="underline">Ghozy Samudra</a>
        </p>
      </div>
      <div class="flex flex-wrap gap-4 text-body-sm md:justify-end">
        <a href="#features">Documentation</a>
        <a href="#configuration">Configuration</a>
        <a href="#usage">Examples</a>
        <a href="#faq">FAQ</a>
      </div>
    </div>
    <p class="mb-0 mt-4 font-['IBM_Plex_Mono'] text-caption text-[color:var(--text-muted)]">© 2026 Tailwind Fluid Typography. MIT License.</p>
  </Container>
</Section>
