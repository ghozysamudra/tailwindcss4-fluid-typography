---
import Section from "./ui/Section.astro";
import Container from "./ui/Container.astro";
import Card from "./ui/Card.astro";
import Button from "./ui/Button.astro";
---

<Section id="getting-started">
  <Container class="opacity-0 translate-y-5 transition duration-500 [will-change:transform,opacity]" data-reveal>
    <h2 class="m-0 text-h2">Getting Started</h2>
    <div class="mt-5 grid gap-4">
      <Card class="min-w-0 overflow-hidden p-5">
        <h3 class="m-0 text-h3">Install in 4 steps</h3>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-body text-[color:var(--text-muted)]">
          <li>Copy <code class="font-['IBM_Plex_Mono']">advanced-fluid-typography.css</code> into your project.</li>
          <li>Import it in your main stylesheet after Tailwind.</li>
          <li>Adjust <code class="font-['IBM_Plex_Mono']">--fluid-*</code> variables to match your type scale and breakpoints.</li>
          <li>Apply semantic classes like <code class="font-['IBM_Plex_Mono']">.text-h2</code> and <code class="font-['IBM_Plex_Mono']">.text-body</code>.</li>
        </ol>
        <Button href="/advanced-fluid-typography.css" download="advanced-fluid-typography.css" class="mt-4 text-body">Download CSS</Button>
      </Card>
    </div>
  </Container>
</Section>
