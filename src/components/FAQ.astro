---
import Section from "./ui/Section.astro";
import Container from "./ui/Container.astro";
import Card from "./ui/Card.astro";

const faqs = [
  { question: "Does this work in all modern browsers?", answer: "Yes. clamp(), custom properties, and modern selectors are widely supported in evergreen browsers." },
  { question: "Will this hurt performance?", answer: "No. This system is CSS-only and avoids runtime JavaScript for typography calculations." },
  { question: "Can I override only one heading size?", answer: "Yes. Override any variable or utility class while keeping the rest of the semantic scale." },
  { question: "How do I pick a ratio?", answer: "Start with 1.25 for balanced hierarchy, then increase for stronger contrast or reduce for denser UIs." },
  { question: "Can I use h2 styling on an h1 element?", answer: "Absolutely. Semantic utility classes are designed for exactly that level of flexibility." },
  { question: "What viewport range should I set?", answer: "A typical range is 360 to 1280. For larger displays, consider 320 to 1440 or 320 to 1920." },
  { question: "Does this replace Tailwind text-* utilities?", answer: "For type scale and semantics, yes. Keep Tailwind utilities for spacing, layout, and color." },
  { question: "Can I use it in Astro, React, and Vue?", answer: "Yes. The class names are framework-agnostic and work anywhere HTML classes are supported." },
  {
    question: "How does this work with Tailwind Typography plugin (`.prose`)?",
    answer: "Use fluid semantic classes for UI you control, and use the Typography plugin for rich text/Markdown you do not control.",
    linkLabel: "View prose demo",
    linkHref: "/prose"
  }
];
---

<Section id="faq">
  <Container class="opacity-0 translate-y-5 transition duration-500 [will-change:transform,opacity]" data-reveal>
    <h2 class="m-0 text-h2">FAQ</h2>
    <div class="mt-5 grid gap-3">
      {
        faqs.map((item) => (
          <Card>
            <details class="p-4">
              <summary class="cursor-pointer text-h4">{item.question}</summary>
              <p class="mb-0 mt-3 text-body text-[color:var(--text-muted)]">{item.answer}</p>
              {
                item.linkHref && item.linkLabel && (
                  <p class="mt-2 text-body-sm">
                    <a href={item.linkHref} class="underline">{item.linkLabel}</a>
                  </p>
                )
              }
            </details>
          </Card>
        ))
      }
    </div>
  </Container>
</Section>
